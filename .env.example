# --- Database (required) ---------------------------------------------------
# Free serverless Postgres: https://neon.tech -> create project -> copy the
# pooled connection string. Also add this to Vercel project env vars.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Media uploads (required for the media library) -------------------------
# Vercel dashboard -> Storage -> Blob -> create store -> copy token.
BLOB_READ_WRITE_TOKEN=""

# --- Secrets (required) ------------------------------------------------------
# Any long random strings. Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
CRON_SECRET=""
PREVIEW_SECRET=""

# --- First admin user (used by `npm run db:seed` / `npm run admin:create`) ---
ADMIN_EMAIL="admin@elenor-marketing.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Super Admin"

# --- Elenor AI (required for the chat assistant) -------------------------------
# Full reference: docs/ai/README.md
#
# Chat provider: anthropic | openai | openrouter | gemini
AI_CHAT_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# AI_CHAT_MODEL=""            # defaults to claude-opus-5 on anthropic
#
# Embeddings. Anthropic has no embeddings endpoint, so the default setup pairs
# Claude for chat with OpenAI for embeddings. To run on one key, set
# AI_CHAT_PROVIDER=openai (or gemini) as well.
AI_EMBEDDING_PROVIDER="openai"
OPENAI_API_KEY=""
# AI_EMBEDDING_MODEL=""       # defaults to text-embedding-3-small
# AI_EMBEDDING_DIMENSIONS=1536  # must match the vector(N) in migration 0004
#
# Other providers
# OPENROUTER_API_KEY=""
# GEMINI_API_KEY=""
#
# Tuning (all optional — defaults shown)
# AI_MAX_CHUNKS=6             # chunks retrieved per question
# AI_MIN_SCORE=0.25           # cosine similarity floor
# AI_MAX_HISTORY_MESSAGES=20  # conversation memory cap
# AI_MAX_OUTPUT_TOKENS=1024
# AI_RATE_LIMIT_REQUESTS=20   # per minute, per IP + session
# AI_PGVECTOR="off"           # force the real[] fallback (local dev without pgvector)

# --- Optional -----------------------------------------------------------------
# Email notifications for new contact messages, sent to requests@elenor-marketing.com
# through the mailbox's own SMTP server. Leave unset to disable (leads still save to the inbox).
# SMTP_HOST=""        # e.g. mail.elenor-marketing.com
# SMTP_PORT="465"     # 465 (SSL) or 587 (STARTTLS)
# SMTP_USER=""        # e.g. requests@elenor-marketing.com
# SMTP_PASS=""
